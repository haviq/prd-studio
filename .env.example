AI_BASE_URL=https://api.example.com/v1
AI_API_KEY=your-key
AI_MODELS=gemini-3.8-flash-high
PUBLIC_URL=https://your-domain
SESSION_SECRET=change-me-long-random
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Turso (optional; enables hosting without a persistent disk, e.g. Render free) ---
# TURSO_DATABASE_URL=libsql://your-db-yourorg.turso.io
# TURSO_AUTH_TOKEN=your-token

# --- Admin console (secret path, e.g. /console-YOURRANDOM; leave empty to disable) ---
# ADMIN_PATH=/console-your-secret-path

# --- Pakasir payments (optional) ---
# PAKASIR_SLUG=your-pakasir-slug
# PAKASIR_API_KEY=your-api-key
# PAKASIR_WEBHOOK_SECRET=long-random-webhook-secret
# PRICE_PRO=49000
